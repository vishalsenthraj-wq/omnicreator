# Google Gemini API key. If unset, the app falls back to a rule-based classifier
# and templated replies — the app still runs and is fully demoable without it.
GEMINI_API_KEY=

# ntfy.sh topic for VIP (BUSINESS_COLLABORATION) push notifications.
# Pick any unique/hard-to-guess topic name, then subscribe to it in the ntfy app.
# If unset, notifications are just logged, never sent.
NTFY_TOPIC=

# Real Instagram Graph API credentials (API setup with Instagram login flow).
# Required for real comment polling / real reply posting. Without these,
# /api/poll-now returns a clear "Instagram not configured" error instead of crashing.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Used to personalize generated reply text.
CREATOR_NAME=Your Name
